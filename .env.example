# Firebase Configuration (Client)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_MEASUREMENT_ID=""

# Cloudflare Credentials (Server-side only)
# Exclusive secure API Bearer Token (requires Zone.DNS, Zone.Email Routing Rules, and Account.Email Routing scopes)
CLOUDFLARE_DNS_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# Google Workspace Admin SDK (Server-side only)
# Base64-encoded service account JSON key with Domain-Wide Delegation enabled
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_KEY=""

# Firebase Admin Credentials (Server-side only)
FIREBASE_SERVICE_ACCOUNT_KEY=""
# Or individual fallback credentials:
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# Optional Custom Banking Display (Client-side)
# BANK_BENEFICIARY="Revlet Platform"
# BANK_ACCOUNT_NO=""
# BANK_NAME=""
