# ==============================================================================
# Revlet Platform (app.revlet.me) - Environment Configuration Template
# ==============================================================================
# NOTE: For cloud production deployments on Vercel,
# add all required variables below to your Vercel project's Environment
# Variables settings. Never commit .env.local or private credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Browser & Server)
# Obtain from Firebase Console > Project Settings > General > Your apps (Web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="revlet.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="revlet"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="revlet.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="759307383400"
NEXT_PUBLIC_FIREBASE_APP_ID="1:759307383400:web:f7d3d41fb771c91f8f81dd"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-K4EPKLCVPE"
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN="revlet.firebaseapp.com"
FIREBASE_PROJECT_ID="revlet"
FIREBASE_STORAGE_BUCKET="revlet.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="759307383400"
FIREBASE_APP_ID="1:759307383400:web:f7d3d41fb771c91f8f81dd"
FIREBASE_MEASUREMENT_ID="G-K4EPKLCVPE"

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK Credentials (CRITICAL - Server Actions & API Routes)
# Used to verify Firebase Auth ID tokens and enforce multi-tenant Firestore RBAC.
# Format: Base64-encoded Service Account JSON or minified JSON string.
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Optional individual fallback credentials (if FIREBASE_SERVICE_ACCOUNT_KEY is omitted):
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 3. Cloudflare DNS API Credentials (CRITICAL - Server-side only)
# Permissions required: Zone > DNS > Edit, Zone > Zone > Read
# ------------------------------------------------------------------------------
CLOUDFLARE_DNS_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# 4. Stalwart Mail Server & DNS Routing (Server-side only)
# Used for JMAP directory provisioning (users, aliases, groups, shared mailboxes)
# ------------------------------------------------------------------------------
STALWART_BASE_URL="https://mx.revlet.me"
STALWART_ADMIN_USER="admin"
STALWART_ADMIN_TOKEN=""
MAIL_MX_HOST="mx.revlet.me"
MAIL_SPF_INCLUDE="_spf.mx.revlet.me"
MAIL_DKIM_TARGET_DOMAIN="dkim.revlet.me"

# ------------------------------------------------------------------------------
# 5. Amazon SES v2 Outbound Relay, SNS Webhooks & Platform Alerts (Server-side)
# Used for automatic domain identity registration in AWS SES v2 (2048-bit DKIM),
# signed SNS bounce/complaint webhooks, and lifecycle alerts from alerts@revlet.me
# ------------------------------------------------------------------------------
AWS_REGION="ap-southeast-2"
AWS_SES_SMTP_HOST="email-smtp.ap-southeast-2.amazonaws.com"
AWS_SES_SMTP_PORT="587"
AWS_SES_SMTP_USER=""
AWS_SES_SMTP_PASSWORD=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SNS_BOUNCE_TOPIC_ARNS=""
REVLET_ALERTS_FROM="Revlet Alerts <alerts@revlet.me>"
REVLET_ACCOUNTS_FROM="Revlet Accounts <accounts@revlet.me>"
REVLET_MAILER_DAEMON_FROM="Mail Delivery Subsystem <mailer-daemon@revlet.me>"
REVLET_SUPPORT_EMAIL="hello@revlet.me"

# ------------------------------------------------------------------------------
# 6. Cryptographic & Control Plane Secrets (Server-side only)
# Generate each with: openssl rand -hex 32
# - TOKEN_ENCRYPTION_SECRET: AES-256-GCM master key for BYOT tokens & TOTP MFA secrets
# - REVLET_MAIL_INTERNAL_SECRET: Shared bearer secret between app.revlet.me & revletmail
# - CRON_SECRET: Bearer secret for /api/mail/v1/purge-expired & /api/mail/v1/quota/reset
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_SECRET=""
REVLET_MAIL_INTERNAL_SECRET=""
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 7. Optional SEO & Production Settings
# ------------------------------------------------------------------------------
# GOOGLE_SITE_VERIFICATION=""
