# ==============================================================================
# Revlet Platform - Environment Configuration Template
# ==============================================================================
# NOTE: For cloud production deployments (e.g., Vercel, Firebase App Hosting),
# you MUST add all variables below to your hosting provider's Environment
# Variables settings (Production, Preview, and Development).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public / Client-side)
# Obtain from Firebase Console > Project Settings > General > Your apps (Web)
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN="revlet.me"
FIREBASE_PROJECT_ID="revlet"
FIREBASE_STORAGE_BUCKET="revlet.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="759307383400"
FIREBASE_APP_ID="1:759307383400:web:f7d3d41fb771c91f8f81dd"
FIREBASE_MEASUREMENT_ID="G-K4EPKLCVPE"

# ------------------------------------------------------------------------------
# 2. Cloudflare API Credentials (CRITICAL - Server-side only)
# Exclusive secure API Bearer Token.
# Permissions required:
#   - Zone > DNS > Edit
#   - Zone > Zone > Read
#   - Zone > Cache Purge > Purge
#   - Zone > Email Routing Rules > Edit
#   - Account > Email Routing Addresses > Edit
# ------------------------------------------------------------------------------
CLOUDFLARE_DNS_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK Credentials (CRITICAL - Server Actions Authentication)
# Generates administrative credentials to verify Firebase ID tokens and access
# Firestore multi-tenant security structures on the server.
# Format: Base64-encoded Service Account JSON or minified JSON string.
# (Generate in Firebase Console > Project Settings > Service accounts > Generate new private key)
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Or individual fallback credentials:
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@revlet.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. Google Workspace Admin SDK (Server-side only)
# Base64-encoded Google Cloud service account JSON key with Domain-Wide
# Delegation (DWD) enabled and delegated to Google Admin SDK directory scopes.
# ------------------------------------------------------------------------------
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_KEY=""

# ------------------------------------------------------------------------------
# 5. Revlet Mail & Stalwart Integration (Server-side only)
# Live Stalwart Mail Server host, DNS routing, and internal security tokens.
# Provisioned on AWS Lightsail in ap-southeast-2 (Sydney) with Static IP 13.239.223.72
# ------------------------------------------------------------------------------
STALWART_BASE_URL="http://13.239.223.72:8080"
STALWART_ADMIN_TOKEN=""
MAIL_MX_HOST="mx.revlet.me"
MAIL_SPF_INCLUDE="_spf.mx.revlet.me"
MAIL_DKIM_TARGET_DOMAIN="dkim.amazonses.com"
AWS_REGION="ap-southeast-2"
AWS_SES_SMTP_HOST="email-smtp.ap-southeast-2.amazonaws.com"

# ------------------------------------------------------------------------------
# 6. Cryptographic Security Secrets (Server-side only)
# Generate each with: openssl rand -hex 32
# TOKEN_ENCRYPTION_SECRET: Master key for AES-256-GCM BYOT Cloudflare API tokens
# REVLET_MAIL_INTERNAL_SECRET: Shared secret between app.revlet.me & revletmail
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_SECRET=""
REVLET_MAIL_INTERNAL_SECRET=""

# ------------------------------------------------------------------------------
# 7. Optional Production Settings
# ------------------------------------------------------------------------------
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
# BANK_BENEFICIARY="Revlet Platform"
# BANK_ACCOUNT_NO=""
# BANK_NAME=""
