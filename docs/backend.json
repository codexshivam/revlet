
{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the registered institutional administrator.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth UID." },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "institution": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Educational institution managed by the portal.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "currentEmail": { "type": "string" },
        "domain": { "type": "string" },
        "cloudflareZoneId": { "type": "string", "description": "The Cloudflare Zone ID associated with this domain. Assigned by platform admin." },
        "dnsRequested": { "type": "boolean", "description": "Whether the user has requested DNS management activation." },
        "hasWebsite": { "type": "boolean", "description": "Whether the user has declared they have an existing website." },
        "siteActiveOn": { "type": "boolean", "description": "Whether the managed REVLET website infrastructure is live (true) or provisioning (false)." },
        "contactName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string" },
        "description": { "type": "string" },
        "code": { "type": "string" },
        "ownerId": { "type": "string" },
        "outstandingAmount": { "type": "number", "description": "The current unpaid balance for this institution." },
        "maxWebEdits": { "type": "number", "description": "Maximum allowed website modifications per month." },
        "usedWebEdits": { "type": "number", "description": "Consumed website modifications in the current cycle." },
        "lastWebQuota": { "type": "string", "format": "date-time", "description": "The timestamp of the last quota reset event." },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "PaymentVoucher": {
      "title": "Payment Voucher",
      "description": "Proof of bank transfer submitted by the administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "organizationName": { "type": "string" },
        "amount": { "type": "number" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "voucherFileName": { "type": "string" },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["Not verified", "Verified", "Rejected"] }
      }
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "A member invited to manage specific organizations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "organizationId": { "type": "string" },
        "organizationName": { "type": "string" },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "invitedAt": { "type": "string", "format": "date-time" }
      }
    },
    "SiteModification": {
      "title": "Site Modification",
      "description": "A request for website or infrastructure change.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Not started", "Pending", "Completed", "Rejected"] },
        "requestedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": "#/backend/entities/Organization",
      "description": "Root collection for educational institutions."
    },
    "/paymentVouchers/{voucherId}": {
      "schema": "#/backend/entities/PaymentVoucher",
      "description": "Submitted proof of payments for verification."
    },
    "/teamMembers/{memberId}": {
      "schema": "#/backend/entities/TeamMember",
      "description": "Invitations and team associations."
    },
    "/siteModifications/{modId}": {
      "schema": "#/backend/entities/SiteModification",
      "description": "History of modifications and requests."
    }
  }
}
