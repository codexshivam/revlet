
{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the registered institutional administrator.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth UID." },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "institution": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Educational institution managed by the portal.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "currentEmail": { "type": "string" },
        "domain": { "type": "string" },
        "hasWebsite": { "type": "boolean" },
        "contactName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string" },
        "description": { "type": "string" },
        "code": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing statement for institutional services.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "organizationName": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["Paid", "Unpaid", "Pending Verification"] },
        "dueDate": { "type": "string", "format": "date" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "PaymentVoucher": {
      "title": "Payment Voucher",
      "description": "Proof of bank transfer submitted by the administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceId": { "type": "string" },
        "organizationId": { "type": "string" },
        "amount": { "type": "number" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "voucherFileName": { "type": "string" },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["Submitted", "Verified", "Rejected"] }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": "#/backend/entities/Organization",
      "description": "Root collection for educational institutions."
    },
    "/invoices/{invoiceId}": {
      "schema": "#/backend/entities/Invoice",
      "description": "Billing records accessible by organization owners."
    },
    "/paymentVouchers/{voucherId}": {
      "schema": "#/backend/entities/PaymentVoucher",
      "description": "Submitted proof of payments for verification."
    }
  }
}
