rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function isResourceOwner() {
      return isOwner(resource.data.ownerId);
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ─── Organizations ────────────────────────────────────────────────────────
    // Owners can manage their organization details. Sensitive service activation
    // and quota fields are mutated exclusively via Admin SDK Server Actions.
    match /organizations/{orgId} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.domain is string
        && request.resource.data.contactName is string
        && request.resource.data.contactEmail is string;
      allow read: if isResourceOwner() || isSuperAdmin() || (
        isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email != null &&
        'memberEmails' in resource.data &&
        request.auth.token.email.lower() in resource.data.memberEmails
      );
      allow update: if (isResourceOwner() || isSuperAdmin())
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          isSuperAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'address', 'phone', 'code', 'contactName', 'contactPhone', 'contactEmail', 'description', 'status', 'updatedAt', 'memberEmails', 'adminEmails', 'memberPermissions'])
        );
      allow delete: if isResourceOwner() || isSuperAdmin();

      match /secrets/{secretId} {
        allow read, write: if false;
      }

      match /dns_snapshots/{snapshotId} {
        allow read, write: if false;
      }

      match /snsProcessedEvents/{eventId} {
        allow read, write: if false;
      }

      // Revlet Mail Service subcollections (accessed & mutated exclusively via Server Actions
      // using Firebase Admin SDK so passwordHash and internal routing state are never exposed to client SDKs)
      match /mailUsers/{mailUserId} {
        allow read, write: if false;
      }

      match /mailGroups/{mailGroupId} {
        allow read, write: if false;
      }

      match /mailOrgUnits/{mailOuId} {
        allow read, write: if false;
      }

      match /mailAuditLogs/{logId} {
        allow read, write: if false;
      }
    }

    // ─── Team Members ─────────────────────────────────────────────────────────
    // Org owners can invite, read, update, delete team members.
    // Invited members can read their own membership records.
    match /teamMembers/{memberId} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.organizationId is string
        && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId))
        && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid;
      allow read: if isResourceOwner() || (
        isAuthenticated() &&
        request.auth.token.email != null &&
        resource.data.email.lower() == request.auth.token.email.lower()
      );
      allow update: if isResourceOwner() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isResourceOwner();
    }



    // ─── Support Tickets ──────────────────────────────────────────────────────
    // Authenticated users can submit support tickets and view their own.
    // SuperAdmin can view and update ticket status / resolution.
    match /supportTickets/{ticketId} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0;
      allow read: if isResourceOwner() || isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if false; // Immutable audit trail
    }

    // ─── User Profiles ────────────────────────────────────────────────────────
    // Users can only read/write their own profile document.
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
