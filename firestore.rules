rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function isResourceOwner() {
      return isOwner(resource.data.ownerId);
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ─── Organizations ────────────────────────────────────────────────────────
    // Owners can create/update basic org metadata. DNS zone bindings, Cloudflare tokens,
    // mail activation, quotas, and membership/permission maps are exclusively server-owned
    // via Admin SDK Server Actions.
    match /organizations/{orgId} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.domain is string
        && request.resource.data.domain.size() > 0
        && request.resource.data.contactName is string
        && request.resource.data.contactEmail is string
        && (!('mailServiceActive' in request.resource.data) || request.resource.data.mailServiceActive == false)
        && request.resource.data.keys().hasOnly([
          'ownerId', 'ownerName', 'name', 'domain', 'code',
          'address', 'phone', 'currentEmail', 'contactName',
          'contactPhone', 'contactEmail', 'description',
          'status', 'createdAt', 'updatedAt', 'mailServiceActive'
        ]);
      // Workspace access is strictly UID-bound (ownerId, memberIds, or authoritative members/{uid});
      // pending invitations are read from /teamMembers and bound to the verified UID upon acceptance.
      allow read: if isResourceOwner() || isSuperAdmin() || (
        isAuthenticated() && (
          ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds) ||
          (
            exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'Active'
          )
        )
      );
      allow update: if (isResourceOwner() || isSuperAdmin())
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          isSuperAdmin() ||
          (
            request.resource.data.domain == resource.data.domain &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'address', 'phone', 'code', 'contactName', 'contactPhone', 'contactEmail', 'description', 'status', 'updatedAt'])
          )
        );
      // Organization deletion must execute via the MFA-gated, legal-hold-checked Server Action.
      allow delete: if false;

      // Authoritative UID-keyed membership records (written exclusively via Admin SDK Server Actions)
      match /members/{memberUid} {
        allow read: if isOwner(memberUid) || isSuperAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid
        );
        allow write: if false;
      }

      match /secrets/{secretId} {
        allow read, write: if false;
      }

      match /privateSecrets/{secretId} {
        allow read, write: if false;
      }

      match /dns_snapshots/{snapshotId} {
        allow read, write: if false;
      }

      match /snsProcessedEvents/{eventId} {
        allow read, write: if false;
      }

      // Revlet Mail Service subcollections (accessed & mutated exclusively via Server Actions
      // using Firebase Admin SDK so passwordHash and internal routing state are never exposed to client SDKs)
      match /mailUsers/{mailUserId} {
        allow read, write: if false;
      }

      match /mailGroups/{mailGroupId} {
        allow read, write: if false;
      }

      match /mailOrgUnits/{mailOuId} {
        allow read, write: if false;
      }

      match /mailAuditLogs/{logId} {
        allow read, write: if false;
      }

      match /mailSharedMailboxes/{mailboxId} {
        allow read, write: if false;
      }

      match /mailQuarantine/{quarantineId} {
        allow read, write: if false;
      }

      match /mailDlpRules/{ruleId} {
        allow read, write: if false;
      }

      match /mailTransportRules/{ruleId} {
        allow read, write: if false;
      }

      match /mailLegalHolds/{holdId} {
        allow read, write: if false;
      }

      match /mailUserSettings/{emailId} {
        allow read, write: if false;
      }

      match /mailUserMfa/{emailId} {
        allow read, write: if false;
      }
    }

    // ─── Telemetry & Crash Reports ────────────────────────────────────────────
    // Written and queried exclusively via Server API routes using Firebase Admin SDK.
    match /crashReports/{reportId} {
      allow read, write: if false;
    }

    match /system/{docId} {
      allow read, write: if false;
    }

    // ─── Team Members ─────────────────────────────────────────────────────────
    // Invitations and memberships are mutated exclusively via Admin SDK Server Actions.
    // Owners and verified invitees/members can read their own membership records.
    match /teamMembers/{memberId} {
      allow create, update, delete: if false;
      allow read: if isResourceOwner() || (
        isAuthenticated() &&
        resource.data.memberUid == request.auth.uid
      ) || (
        // Verified email matching is permitted ONLY for unbound Pending invitations.
        isAuthenticated() &&
        resource.data.status == 'Pending' &&
        (!('memberUid' in resource.data) || resource.data.memberUid == null) &&
        request.auth.token.email_verified == true &&
        request.auth.token.email != null &&
        resource.data.email.lower() == request.auth.token.email.lower()
      );
    }



    // ─── Support Tickets ──────────────────────────────────────────────────────
    // Authenticated users can submit support tickets and view their own.
    // SuperAdmin can view and update ticket status / resolution.
    match /supportTickets/{ticketId} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0;
      allow read: if isResourceOwner() || isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if false; // Immutable audit trail
    }

    // ─── User Profiles ────────────────────────────────────────────────────────
    // Users can only read/write safe profile fields on their own document.
    // All MFA secrets, passkeys, challenges, and recovery OTP state live in
    // server-only subcollections (privateMfa, mfaPasskeys, mfaChallenges).
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'theme', 'timezone', 'locale',
          'lastActiveOrgId', 'createdAt', 'updatedAt'
        ]);
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'theme', 'timezone', 'locale',
          'lastActiveOrgId', 'updatedAt'
        ]);
      allow delete: if false;

      match /privateMfa/{docId} {
        allow read, write: if false;
      }

      match /mfaPasskeys/{passkeyId} {
        allow read, write: if false;
      }

      match /mfaChallenges/{challengeId} {
        allow read, write: if false;
      }
    }
  }
}
