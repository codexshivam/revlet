rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'shivam@revlet.me')
      );
    }

    function isOrgOwnerOrMember(orgId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          firestore.exists(/databases/itmanager/documents/organizations/$(orgId)) &&
          (
            firestore.get(/databases/itmanager/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
            (
              'memberEmails' in firestore.get(/databases/itmanager/documents/organizations/$(orgId)).data &&
              request.auth.token.email != null &&
              request.auth.token.email.lower() in firestore.get(/databases/itmanager/documents/organizations/$(orgId)).data.memberEmails
            )
          )
        )
      );
    }

    // ─── User Profile Assets ──────────────────────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // ─── Payment Vouchers ─────────────────────────────────────────────────────
    match /vouchers/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // ─── Organization Assets ──────────────────────────────────────────────────
    match /organizations/{orgId}/{allPaths=**} {
      allow read: if isOrgOwnerOrMember(orgId);
      allow write: if isOrgOwnerOrMember(orgId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // ─── Default Deny ────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
