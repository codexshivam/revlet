rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOrgOwner(orgId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          firestore.exists(/databases/(default)/documents/organizations/$(orgId)) &&
          firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid
        )
      );
    }

    function isOrgOwnerOrMember(orgId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          firestore.exists(/databases/(default)/documents/organizations/$(orgId)) &&
          (
            firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
            (
              'memberIds' in firestore.get(/databases/(default)/documents/organizations/$(orgId)).data &&
              request.auth.uid in firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.memberIds
            ) ||
            (
              firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
              firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'Active'
            )
          )
        )
      );
    }

    // ─── User Profile Assets ──────────────────────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // ─── Payment Vouchers ─────────────────────────────────────────────────────
    match /vouchers/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // ─── Organization Assets ──────────────────────────────────────────────────
    match /organizations/{orgId}/{allPaths=**} {
      allow read: if isOrgOwnerOrMember(orgId);
      allow write: if isOrgOwner(orgId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // ─── Default Deny ────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
